{
  "manifest_version": 3,
  "name": "Smart Time Tracker",
  "description": "Local-first, accurate attention tracking for Chrome.",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "permissions": ["tabs", "idle", "storage"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Open productivity dashboard" },
  "options_page": "dashboard/index.html",
  "web_accessible_resources": [{ "resources": ["blocked/index.html"], "matches": ["<all_urls>"] }]
}
